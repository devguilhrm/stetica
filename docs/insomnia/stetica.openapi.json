  "components": {
    "schemas": {
      "CadastroInput": {
        "required": [
          "cpf",
          "email",
          "endereco",
          "nome",
          "senha",
          "sexo",
          "telefone"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "cpf": {
            "minLength": 1,
            "pattern": "\\d{11}",
            "type": "string"
          },
          "dataNascimento": {
            "type": "string",
            "format": "date-time"
          },
          "sexo": {
            "minLength": 1,
            "pattern": "[MFO]",
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "telefone": {
            "minLength": 1,
            "pattern": "\\d{10,11}",
            "type": "string"
          },
          "endereco": {
            "$ref": "#/components/schemas/EnderecoInput"
          },
          "senha": {
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CategoriaInput": {
        "required": [
          "nome"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 35,
            "minLength": 2,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "EnderecoInput": {
        "required": [
          "bairro",
          "cep",
          "cidade",
          "logradouro",
          "numero",
          "uf"
        ],
        "type": "object",
        "properties": {
          "cep": {
            "minLength": 1,
            "pattern": "\\d{8}",
            "type": "string"
          },
          "logradouro": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "bairro": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "cidade": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "uf": {
            "minLength": 1,
            "pattern": "[A-Z]{2}",
            "type": "string"
          },
          "numero": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string"
          },
          "complemento": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EntradaInput": {
        "type": "object",
        "properties": {
          "produtoId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "quantidade": {
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "valorUnitario": {
            "maximum": 99999999.99,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "data": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "FuncionarioInput": {
        "required": [
          "cargo",
          "cpf",
          "email",
          "endereco",
          "nome",
          "sexo",
          "telefone"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "cpf": {
            "minLength": 1,
            "pattern": "\\d{11}",
            "type": "string"
          },
          "dataNascimento": {
            "type": "string",
            "format": "date-time"
          },
          "sexo": {
            "minLength": 1,
            "pattern": "[MFO]",
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "telefone": {
            "minLength": 1,
            "pattern": "\\d{10,11}",
            "type": "string"
          },
          "endereco": {
            "$ref": "#/components/schemas/EnderecoInput"
          },
          "cargo": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "dataAdmissao": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "ItemInput": {
        "required": [
          "descricao",
          "nome",
          "tipo",
          "unidade"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 40,
            "minLength": 2,
            "type": "string"
          },
          "descricao": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "categoriaId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "tipo": {
            "minLength": 1,
            "pattern": "[PS]",
            "type": "string"
          },
          "preco": {
            "maximum": 99999999.99,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "ativo": {
            "type": "boolean"
          },
          "codigoPreco": {
            "maximum": 3,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "unidade": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginInput": {
        "required": [
          "email",
          "senha"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "senha": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PedidoInput": {
        "required": [
          "itens"
        ],
        "type": "object",
        "properties": {
          "itens": {
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PedidoLinhaInput"
            }
          }
        },
        "additionalProperties": false
      },
      "PedidoLinhaInput": {
        "type": "object",
        "properties": {
          "itemId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "quantidade": {
            "maximum": 10000,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "funcionarioId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "PessoaInput": {
        "required": [
          "cpf",
          "email",
          "endereco",
          "nome",
          "sexo",
          "telefone"
        ],
        "type": "object",
        "properties": {
          "nome": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "cpf": {
            "minLength": 1,
            "pattern": "\\d{11}",
            "type": "string"
          },
          "dataNascimento": {
            "type": "string",
            "format": "date-time"
          },
          "sexo": {
            "minLength": 1,
            "pattern": "[MFO]",
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "telefone": {
            "minLength": 1,
            "pattern": "\\d{10,11}",
            "type": "string"
          },
          "endereco": {
            "$ref": "#/components/schemas/EnderecoInput"
          }
        },
        "additionalProperties": false
      },
      "StatusInput": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "minLength": 1,
            "pattern": "^(Em processamento|Concluído|Cancelado)$",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "AdminKey": {
        "type": "apiKey",
        "description": "Use a chave configurada em Admin:Key na sua API.",
        "name": "X-Admin-Key",
        "in": "header"
      },
      "Bearer": {
        "type": "http",
        "description": "Cadastre ou autentique um cliente e cole apenas o token retornado, sem o prefixo Bearer.",
        "scheme": "bearer"
      }
    }
  },
